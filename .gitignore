# Temporary files (screenshots, scripts for dev use)
.tmp/

# Git worktrees
.worktrees/

# Dependencies
node_modules/

# Environment files (never commit real secrets)
.env
.env.local
.env.*.local

# Build outputs
dist/
build/

# Turbo cache
.turbo/

# TypeScript build info
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Test coverage
coverage/

# pnpm lock (keep pnpm-lock.yaml committed)

# Claude Code — local-only data (not project tooling)
# Keep: .claude/commands/ (project slash commands), .specify/ (constitution + templates)
# Keep: docs/superpowers/ (design specs and plans are project artifacts)
# Ignore: local settings and session state only
.claude/settings.local.json
.claude/todos/
.claude/scheduled_tasks.lock

# Other AI-tool configs/skills — auto-generated by code-review-graph MCP per editor,
# duplicated from .claude/. Machine-specific (.mcp.json/.vscode/mcp.json embed abs local
# paths). Keep only .claude/ as the tracked tool config.
.claude/skills/
.codebuddy/
.cursorrules
.gemini/
.github/instructions/
.kiro/
.mcp.json
.qoder/
.vscode/mcp.json
.windsurfrules
CODEBUDDY.md
GEMINI.md
QODER.md
opencode.jsonc

# Playwright test artifacts
.playwright-mcp/
test-results/

# Windows device name artifact (bash redirect to /dev/null on WSL creates this ghost)
nul

# Ad-hoc smoke test screenshots
*-checklist-*.png
*-smoke-*.png
# Added by code-review-graph
.code-review-graph/
