# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medassist_dev

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=replace_with_random_64_char_hex_string
JWT_EXPIRY_MINUTES=60

# Telegram notifications (worker process only)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_IDS=chat_id_1,chat_id_2
# Must be explicitly "true" for the worker to actually call the Telegram API.
# Any other value (including unset) dry-runs: logs the message, never sends it.
# Prevents repeated dev/test runs from spamming/rate-limiting the real bot.
TELEGRAM_SEND_ENABLED=false

# AWS S3 / Object Storage
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
# AWS_S3_BUCKET takes precedence over AWS_BUCKET_NAME if both are set.
AWS_BUCKET_NAME=medassist-dev
AWS_REGION=eu-west-1
# Set only when pointing at a LocalStack/S3-compatible endpoint (dev).
# Leave unset to use real AWS S3 (prod).
AWS_ENDPOINT_URL=

# App URLs
PATIENT_APP_URL=http://localhost:5173
STAFF_APP_URL=http://localhost:5174
MAGIC_LINK_BASE_URL=http://localhost:5173/visit

# Magic Link TTLs (hours)
ELECTIVE_LINK_TTL_HOURS=72
ER_LINK_TTL_HOURS=12

# Puppeteer (leave blank to use bundled Chromium)
PUPPETEER_EXECUTABLE_PATH=

# Node environment
NODE_ENV=development
PORT=3000
# Only relevant when NODE_ENV=production (dev/test are never Secure).
# In production the cookie defaults Secure; set explicitly to "false" only
# for a plain-HTTP deployment (e.g. IP-only demo box with no TLS).
COOKIE_SECURE=true
